---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/assets';
---

<Layout title={`Contacto | ${siteConfig.name}`}>
  <Navbar />

  <main class="pt-24 md:pt-28 pb-16 md:pb-24 bg-gradient-to-b from-gray-50 to-white min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12 md:mb-16">
        <span class="inline-block bg-asc-orange/10 text-asc-orange font-semibold text-xs md:text-sm uppercase tracking-widest px-4 py-2 rounded-full mb-4">
          Contacto
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mt-4 mb-6">
          Escribanos y <span class="text-asc-orange">Cotizemos</span>
        </h1>
        <p class="text-gray-600 max-w-3xl mx-auto text-base md:text-lg lg:text-xl leading-relaxed">
          Los precios se manejan por contacto directo. Escribanos por WhatsApp o correo
          electronico para recibir su cotizacion personalizada. Atendemos tour operadores,
          empresas de aventura y seguridad en altura en toda Costa Rica.
        </p>
      </div>

      <!-- Contact Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 mb-12 md:mb-16">
        <!-- WhatsApp Principal -->
        <a
          href={`https://wa.me/${siteConfig.whatsapp.replace('+', '')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white rounded-3xl p-6 md:p-8 shadow-lg hover:shadow-2xl transition-all duration-300 border border-gray-100 hover:border-green-500/50 hover:-translate-y-1"
        >
          <div class="flex items-start space-x-4 md:space-x-5">
            <div class="flex-shrink-0 w-14 h-14 md:w-16 md:h-16 rounded-2xl bg-green-100 group-hover:bg-green-500 flex items-center justify-center transition-colors duration-300">
              <svg class="w-7 h-7 md:w-8 md:h-8 text-green-600 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-xs md:text-sm text-gray-500 uppercase tracking-wider font-semibold mb-1">WhatsApp Ventas</p>
              <p class="text-xl md:text-2xl font-bold text-gray-900 group-hover:text-green-600 transition-colors break-all">{siteConfig.phone}</p>
              <p class="text-sm text-gray-500 mt-2">Toque para iniciar chat</p>
            </div>
          </div>
        </a>

        <!-- WhatsApp Secundario -->
        <a
          href={`https://wa.me/${siteConfig.whatsapp2.replace('+', '')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white rounded-3xl p-6 md:p-8 shadow-lg hover:shadow-2xl transition-all duration-300 border border-gray-100 hover:border-green-500/50 hover:-translate-y-1"
        >
          <div class="flex items-start space-x-4 md:space-x-5">
            <div class="flex-shrink-0 w-14 h-14 md:w-16 md:h-16 rounded-2xl bg-green-100 group-hover:bg-green-500 flex items-center justify-center transition-colors duration-300">
              <svg class="w-7 h-7 md:w-8 md:h-8 text-green-600 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-xs md:text-sm text-gray-500 uppercase tracking-wider font-semibold mb-1">WhatsApp Directo</p>
              <p class="text-xl md:text-2xl font-bold text-gray-900 group-hover:text-green-600 transition-colors break-all">{siteConfig.phone2}</p>
              <p class="text-sm text-gray-500 mt-2">Toque para iniciar chat</p>
            </div>
          </div>
        </a>

        <!-- Email -->
        <a
          href={`mailto:${siteConfig.email}?subject=Solicitud de Cotizacion`}
          class="group bg-white rounded-3xl p-6 md:p-8 shadow-lg hover:shadow-2xl transition-all duration-300 border border-gray-100 hover:border-asc-orange/50 hover:-translate-y-1"
        >
          <div class="flex items-start space-x-4 md:space-x-5">
            <div class="flex-shrink-0 w-14 h-14 md:w-16 md:h-16 rounded-2xl bg-asc-orange/10 group-hover:bg-asc-orange flex items-center justify-center transition-colors duration-300">
              <svg class="w-7 h-7 md:w-8 md:h-8 text-asc-orange group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-xs md:text-sm text-gray-500 uppercase tracking-wider font-semibold mb-1">Correo Electronico</p>
              <p class="text-lg md:text-xl lg:text-2xl font-bold text-gray-900 group-hover:text-asc-orange transition-colors break-all">{siteConfig.email}</p>
              <p class="text-sm text-gray-500 mt-2">Solicite cotizacion</p>
            </div>
          </div>
        </a>

        <!-- Horarios -->
        <div class="bg-white rounded-3xl p-6 md:p-8 shadow-lg border border-gray-100">
          <div class="flex items-start space-x-4 md:space-x-5">
            <div class="flex-shrink-0 w-14 h-14 md:w-16 md:h-16 rounded-2xl bg-asc-navy/10 flex items-center justify-center">
              <svg class="w-7 h-7 md:w-8 md:h-8 text-asc-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-xs md:text-sm text-gray-500 uppercase tracking-wider font-semibold mb-2">Horario de Atencion</p>
              <p class="text-base md:text-lg font-semibold text-gray-900">{siteConfig.hours.weekdays}</p>
              <p class="text-base md:text-lg font-semibold text-gray-900">{siteConfig.hours.saturday}</p>
              <p class="text-sm text-gray-500 mt-2">Domingos cerrado</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Big CTA Banner -->
      <div class="bg-gradient-to-br from-gray-900 to-asc-navy rounded-3xl p-8 md:p-12 lg:p-16 text-white text-center">
        <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-4 md:mb-6">
          ¿Listo para cotizar su equipo?
        </h2>
        <p class="text-white/80 text-base md:text-lg lg:text-xl mb-8 max-w-2xl mx-auto leading-relaxed">
          Escribanos hoy y reciba una cotizacion personalizada para su operacion. Ofrecemos
          precios mayoristas y por unidad con la mejor asesoria tecnica.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 md:gap-4 justify-center">
          <a
            href={`https://wa.me/${siteConfig.whatsapp.replace('+', '')}?text=Hola,%20me%20gustaria%20cotizar%20equipo.`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center space-x-2 bg-green-500 hover:bg-green-600 text-white px-6 py-3 md:px-8 md:py-4 rounded-full font-bold text-base md:text-lg transition-all duration-300 hover:scale-105 shadow-xl"
          >
            <svg class="w-5 h-5 md:w-6 md:h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <span>WhatsApp {siteConfig.phone}</span>
          </a>
          <a
            href={`https://wa.me/${siteConfig.whatsapp2.replace('+', '')}?text=Hola,%20me%20gustaria%20cotizar%20equipo.`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center space-x-2 bg-green-500 hover:bg-green-600 text-white px-6 py-3 md:px-8 md:py-4 rounded-full font-bold text-base md:text-lg transition-all duration-300 hover:scale-105 shadow-xl"
          >
            <svg class="w-5 h-5 md:w-6 md:h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <span>WhatsApp {siteConfig.phone2}</span>
          </a>
          <a
            href={`mailto:${siteConfig.email}?subject=Solicitud de Cotizacion`}
            class="inline-flex items-center justify-center space-x-2 bg-asc-orange hover:bg-orange-600 text-white px-6 py-3 md:px-8 md:py-4 rounded-full font-bold text-base md:text-lg transition-all duration-300 hover:scale-105 shadow-xl"
          >
            <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span>Correo</span>
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
