---
import { assets, siteConfig } from '../config/assets';
---

<section class="py-20 bg-gradient-to-br from-gray-900 via-asc-navy to-gray-900 relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%23ffffff\" fill-opacity=\"0.4\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div class="text-white">
        <span class="text-asc-orange font-semibold text-sm uppercase tracking-widest">B2B / Mayoristas</span>
        <h2 class="text-4xl md:text-5xl font-bold mt-4 mb-6 leading-tight">
          Si eres un tour operador o guia de turismo,
          <span class="text-asc-orange">no busques mas.</span>
        </h2>
        <p class="text-white/80 text-lg mb-8 leading-relaxed">
          Confia en nuestra tienda de aventura para equiparte con los mejores equipos
          y servicios del mercado. Contacta con nosotros hoy mismo y descubre como
          podemos ayudarte a llevar tus aventuras al siguiente nivel.
        </p>

        <!-- Features List -->
        <ul class="space-y-4 mb-8">
          <li class="flex items-center space-x-3">
            <div class="w-6 h-6 rounded-full bg-asc-orange flex items-center justify-center">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <span class="text-white/90">Precios especiales para mayoristas</span>
          </li>
          <li class="flex items-center space-x-3">
            <div class="w-6 h-6 rounded-full bg-asc-orange flex items-center justify-center">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <span class="text-white/90">Distribuidor autorizado de marcas premium</span>
          </li>
          <li class="flex items-center space-x-3">
            <div class="w-6 h-6 rounded-full bg-asc-orange flex items-center justify-center">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <span class="text-white/90">Asesoria tecnica especializada</span>
          </li>
        </ul>

        <!-- CTA -->
        <a
          href={`https://wa.me/${siteConfig.whatsapp.replace('+', '')}?text=Hola, soy tour operador y me gustaria informacion sobre precios mayoristas`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-2 bg-asc-orange hover:bg-orange-600 text-white px-8 py-4 rounded-full font-bold text-lg transition-all duration-300 transform hover:scale-105"
        >
          <span>Solicitar Informacion</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <!-- Image -->
      <div class="relative">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl transform rotate-2 hover:rotate-0 transition-transform duration-500">
          <img
            src={assets.categories.gear}
            alt="Equipo profesional de aventura"
            class="w-full h-auto"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-asc-orange/30 to-transparent"></div>
        </div>

        <!-- Floating Badge -->
        <div class="absolute -bottom-6 -left-6 bg-white rounded-2xl p-6 shadow-xl">
          <div class="text-center">
            <span class="text-4xl font-bold text-asc-orange">15+</span>
            <p class="text-gray-600 text-sm font-medium">Anos de experiencia</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
