---
import { assets, siteConfig } from '../config/assets';
---

<section class="py-24 lg:py-32 bg-gradient-to-br from-gray-900 via-asc-navy to-gray-900 relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%23ffffff\" fill-opacity=\"0.4\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-20">
      <span class="inline-block bg-asc-orange/20 text-asc-orange font-semibold text-sm uppercase tracking-widest px-4 py-2 rounded-full mb-4">
        Proveedor del Sector Turismo
      </span>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mt-4 mb-6">
        Equipamos al Turismo<br/>
        <span class="text-asc-orange">de Aventura en Costa Rica</span>
      </h2>
      <p class="text-white/70 max-w-3xl mx-auto text-lg md:text-xl leading-relaxed">
        Somos el proveedor de confianza para empresas tour operadoras que trabajan en
        <strong class="text-white">actividades acuaticas</strong> (rafting, kayak, tubing),
        <strong class="text-white">operaciones en altura</strong> (canopy, escalada, puentes colgantes) y
        <strong class="text-white">seguridad en altura industrial</strong>.
        Ofrecemos precios mayoristas y por unidad — cotice con nosotros para obtener los mejores precios.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Content -->
      <div class="text-white">
        <h3 class="text-3xl md:text-4xl font-bold mb-8 leading-tight">
          Su proveedor de equipo profesional para turismo y seguridad en altura
        </h3>
        <p class="text-white/80 text-lg mb-10 leading-relaxed">
          Mas de 15 anos de experiencia equipando a los mejores operadores de turismo
          en Costa Rica. Atendemos empresas de rafting, canopy, escalada, puentes colgantes
          y seguridad industrial en altura.
        </p>

        <!-- Features List -->
        <ul class="space-y-6 mb-12">
          <li class="flex items-start space-x-4">
            <div class="w-8 h-8 rounded-full bg-asc-orange flex items-center justify-center flex-shrink-0 mt-1">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <div>
              <h4 class="text-xl font-bold text-white mb-1">Precios Mayoristas y por Unidad</h4>
              <p class="text-white/70">Manejamos precios mayoristas para compras en volumen y precios por unidad. Cotice con nosotros para obtener mejores precios segun su necesidad.</p>
            </div>
          </li>
          <li class="flex items-start space-x-4">
            <div class="w-8 h-8 rounded-full bg-asc-orange flex items-center justify-center flex-shrink-0 mt-1">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <div>
              <h4 class="text-xl font-bold text-white mb-1">Cotizacion por Correo o WhatsApp</h4>
              <p class="text-white/70">Los precios se manejan por contacto directo. Escribanos por correo electronico o WhatsApp para recibir su cotizacion personalizada.</p>
            </div>
          </li>
          <li class="flex items-start space-x-4">
            <div class="w-8 h-8 rounded-full bg-asc-orange flex items-center justify-center flex-shrink-0 mt-1">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <div>
              <h4 class="text-xl font-bold text-white mb-1">Distribuidor Autorizado</h4>
              <p class="text-white/70">Productos 100% originales de CMI, Fusion, Sterling, Singing Rock, Rocky Mountain y mas. Certificados y de grado profesional.</p>
            </div>
          </li>
          <li class="flex items-start space-x-4">
            <div class="w-8 h-8 rounded-full bg-asc-orange flex items-center justify-center flex-shrink-0 mt-1">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <div>
              <h4 class="text-xl font-bold text-white mb-1">Equipo para Agua, Altura y Seguridad</h4>
              <p class="text-white/70">Chalecos, arneses, mosquetones, cuerdas, poleas, cascos y todo el equipo que su operacion necesita. Asesoria tecnica incluida.</p>
            </div>
          </li>
        </ul>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={`https://wa.me/${siteConfig.whatsapp.replace('+', '')}?text=Hola, me gustaria cotizar equipo. Soy tour operador.`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center space-x-3 bg-green-500 hover:bg-green-600 text-white px-10 py-5 rounded-full font-bold text-lg transition-all duration-300 transform hover:scale-105 shadow-xl hover:shadow-green-500/30"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <span>Cotizar por WhatsApp</span>
          </a>
          <a
            href={`mailto:${siteConfig.email}?subject=Solicitud de Cotizacion`}
            class="inline-flex items-center space-x-3 bg-asc-orange hover:bg-orange-600 text-white px-10 py-5 rounded-full font-bold text-lg transition-all duration-300 transform hover:scale-105 shadow-xl hover:shadow-asc-orange/30"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span>Cotizar por Correo</span>
          </a>
        </div>
      </div>

      <!-- Image & Stats -->
      <div class="relative">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl">
          <img
            src={assets.categories.gear}
            alt="Equipo profesional de aventura"
            class="w-full h-auto"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
        </div>

        <!-- Stats Cards -->
        <div class="absolute -bottom-8 -left-8 bg-white rounded-2xl p-6 shadow-2xl">
          <div class="text-center">
            <span class="text-5xl font-bold text-asc-orange">15+</span>
            <p class="text-gray-600 text-sm font-medium mt-1">Anos de<br/>Experiencia</p>
          </div>
        </div>

        <div class="absolute -top-8 -right-8 bg-white rounded-2xl p-6 shadow-2xl">
          <div class="text-center">
            <span class="text-5xl font-bold text-asc-navy">100+</span>
            <p class="text-gray-600 text-sm font-medium mt-1">Operadores<br/>Satisfechos</p>
          </div>
        </div>

        <div class="absolute top-1/2 -right-4 transform -translate-y-1/2 bg-asc-orange rounded-2xl p-6 shadow-2xl">
          <div class="text-center">
            <span class="text-4xl font-bold text-white">11</span>
            <p class="text-white/90 text-sm font-medium mt-1">Marcas<br/>Premium</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
