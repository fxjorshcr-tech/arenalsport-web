---
import { categoriesData } from '../config/assets';
---

<section id="categorias" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="text-asc-orange font-semibold text-sm uppercase tracking-widest">Nuestros Productos</span>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mt-2 mb-4">
        Categorias
      </h2>
      <p class="text-gray-600 max-w-2xl mx-auto text-lg">
        Todo el equipo que necesitas para llevar tus aventuras al siguiente nivel
      </p>
    </div>

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {categoriesData.map((category, index) => (
        <a
          href={category.href}
          class="group relative overflow-hidden rounded-2xl aspect-[4/5] bg-gray-900 shadow-xl transform transition-all duration-500 hover:scale-[1.02] hover:shadow-2xl"
          style={`animation-delay: ${index * 0.1}s`}
        >
          <!-- Image -->
          <img
            src={category.image}
            alt={category.title}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            loading="lazy"
          />

          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity duration-300"></div>

          <!-- Content -->
          <div class="absolute inset-0 flex flex-col justify-end p-6 lg:p-8">
            <span class="text-asc-orange font-medium text-sm uppercase tracking-wider mb-1">
              {category.subtitle}
            </span>
            <h3 class="text-2xl lg:text-3xl font-bold text-white mb-3 group-hover:text-asc-orange transition-colors duration-300">
              {category.title}
            </h3>

            <!-- Arrow Icon -->
            <div class="flex items-center text-white/80 group-hover:text-white transition-all duration-300 transform group-hover:translate-x-2">
              <span class="text-sm font-medium mr-2">Ver productos</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </div>
          </div>

          <!-- Hover Border Effect -->
          <div class="absolute inset-0 border-4 border-transparent group-hover:border-asc-orange rounded-2xl transition-colors duration-300"></div>
        </a>
      ))}
    </div>
  </div>
</section>
