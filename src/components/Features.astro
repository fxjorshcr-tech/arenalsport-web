---
import { siteConfig } from '../config/assets';

const features = [
  {
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>`,
    title: 'Envio Nacional',
    description: 'Te enviamos tus pedidos a cualquier parte del pais'
  },
  {
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>`,
    title: 'Pagos Seguros',
    description: 'PayPal, Transferencia bancaria y SINPE Movil'
  },
  {
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    title: 'Horarios',
    description: `${siteConfig.hours.weekdays} | ${siteConfig.hours.saturday}`
  },
  {
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>`,
    title: 'Contacto',
    description: `Tel: ${siteConfig.phone} | ${siteConfig.email}`
  }
];
---

<section id="contacto" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="text-asc-orange font-semibold text-sm uppercase tracking-widest">Por que elegirnos</span>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mt-2 mb-4">
        A Tu Servicio
      </h2>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {features.map((feature, index) => (
        <div
          class="text-center p-8 rounded-2xl bg-gray-50 hover:bg-asc-orange/10 transition-all duration-300 group"
          style={`animation-delay: ${index * 0.1}s`}
        >
          <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-white shadow-lg text-gray-600 group-hover:text-asc-orange group-hover:shadow-asc-orange/20 transition-all duration-300 mb-6">
            <Fragment set:html={feature.icon} />
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-asc-orange transition-colors">
            {feature.title}
          </h3>
          <p class="text-gray-600 leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
