---
import { siteConfig } from '../config/assets';

const features = [
  {
    icon: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    title: 'Precios por Cotizacion',
    description: 'Manejamos precios mayoristas y precios por unidad. Los precios se gestionan por contacto directo via correo electronico o WhatsApp. Cotice para obtener los mejores precios.',
    highlight: 'Mayorista y por Unidad'
  },
  {
    icon: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>`,
    title: 'Envio Nacional',
    description: 'Enviamos a cualquier parte de Costa Rica. Servicio rapido y seguro para tour operadores y empresas en todo el pais.',
    highlight: 'Todo el pais'
  },
  {
    icon: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>`,
    title: 'Pagos Seguros',
    description: 'Multiples opciones de pago: PayPal, transferencia bancaria y SINPE Movil. Facturacion para empresas.',
    highlight: 'PayPal, SINPE, Transferencia'
  },
  {
    icon: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>`,
    title: 'Contacto Directo',
    description: 'Escribanos por WhatsApp o correo electronico para cotizar. Atencion personalizada para tour operadores y empresas de seguridad en altura.',
    highlight: 'WhatsApp y Email'
  }
];
---

<section id="contacto" class="py-24 lg:py-32 bg-gradient-to-b from-white to-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-20">
      <span class="inline-block bg-asc-orange/10 text-asc-orange font-semibold text-sm uppercase tracking-widest px-4 py-2 rounded-full mb-4">
        Por que elegirnos
      </span>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mt-4 mb-6">
        A Tu Servicio
      </h2>
      <p class="text-gray-600 max-w-3xl mx-auto text-lg md:text-xl leading-relaxed">
        Nos comprometemos a brindarte la mejor experiencia de compra,
        con atencion personalizada y envio a todo el pais.
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10 mb-20">
      {features.map((feature, index) => (
        <div
          class="bg-white p-10 rounded-3xl shadow-lg hover:shadow-2xl transition-all duration-500 group border border-gray-100 hover:border-asc-orange/30"
          style={`animation-delay: ${index * 0.1}s`}
        >
          <div class="flex items-start space-x-6">
            <div class="flex-shrink-0 w-20 h-20 rounded-2xl bg-gray-100 group-hover:bg-asc-orange/10 flex items-center justify-center text-gray-600 group-hover:text-asc-orange transition-all duration-300">
              <Fragment set:html={feature.icon} />
            </div>
            <div class="flex-1">
              <h3 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-asc-orange transition-colors">
                {feature.title}
              </h3>
              <p class="text-gray-600 leading-relaxed mb-4">
                {feature.description}
              </p>
              <span class="inline-block bg-asc-orange/10 text-asc-orange font-semibold text-sm px-4 py-2 rounded-full">
                {feature.highlight}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Contact Info Cards -->
    <div class="bg-gradient-to-br from-gray-900 to-asc-navy rounded-3xl p-10 lg:p-16 text-white">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Info -->
        <div>
          <h3 class="text-3xl md:text-4xl font-bold mb-6">
            Cotice con Nosotros
          </h3>
          <p class="text-white/80 text-lg mb-8 leading-relaxed">
            Los precios se manejan por contacto directo. Escribanos por correo electronico
            o WhatsApp para recibir su cotizacion. Ofrecemos precios mayoristas y por unidad
            — entre mas cotice, mejores precios obtiene.
          </p>

          <div class="space-y-6">
            <div class="flex items-center space-x-4">
              <div class="w-12 h-12 rounded-full bg-asc-orange/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-asc-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <p class="text-white/60 text-sm">Telefono</p>
                <p class="text-xl font-bold">{siteConfig.phone}</p>
              </div>
            </div>

            <div class="flex items-center space-x-4">
              <div class="w-12 h-12 rounded-full bg-asc-orange/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-asc-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="text-white/60 text-sm">Email</p>
                <p class="text-xl font-bold">{siteConfig.email}</p>
              </div>
            </div>

            <div class="flex items-center space-x-4">
              <div class="w-12 h-12 rounded-full bg-asc-orange/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-asc-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <p class="text-white/60 text-sm">Horarios</p>
                <p class="text-lg font-semibold">{siteConfig.hours.weekdays}</p>
                <p class="text-lg font-semibold">{siteConfig.hours.saturday}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- CTA -->
        <div class="text-center lg:text-left">
          <div class="bg-white/10 backdrop-blur-lg rounded-3xl p-10 border border-white/20">
            <h4 class="text-2xl font-bold mb-4">¿Listo para cotizar?</h4>
            <p class="text-white/80 mb-8">
              Solicite su cotizacion ahora. Atendemos tour operadores, empresas de aventura
              y seguridad en altura en toda Costa Rica.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href={`https://wa.me/${siteConfig.whatsapp.replace('+', '')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center space-x-2 bg-green-500 hover:bg-green-600 text-white px-8 py-4 rounded-full font-bold text-lg transition-all duration-300 hover:scale-105"
              >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                <span>WhatsApp</span>
              </a>
              <a
                href={`tel:${siteConfig.phone.replace('-', '')}`}
                class="inline-flex items-center justify-center space-x-2 bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-full font-bold text-lg transition-all duration-300 border border-white/30"
              >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <span>Llamar</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
