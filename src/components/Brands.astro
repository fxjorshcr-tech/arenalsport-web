---
import { brandPartners } from '../config/assets';
---

<section class="py-24 lg:py-32 bg-gradient-to-b from-gray-50 to-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-20">
      <span class="inline-block bg-asc-orange/10 text-asc-orange font-semibold text-sm uppercase tracking-widest px-4 py-2 rounded-full mb-4">
        Importador & Distribuidor
      </span>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mt-4 mb-6">
        Ventas Mayoristas
      </h2>
      <p class="text-gray-600 max-w-3xl mx-auto text-lg md:text-xl leading-relaxed">
        Somos distribuidores autorizados de las mejores marcas del mundo en equipo de aventura.
        Productos originales con garantia de fabrica.
      </p>
    </div>

    <!-- Brands Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6 lg:gap-8 mb-20">
      {brandPartners.map((brand) => (
        <div class="bg-white rounded-2xl p-6 lg:p-8 shadow-lg hover:shadow-2xl transition-all duration-500 flex items-center justify-center h-28 lg:h-32 group hover:scale-105 border border-gray-100 hover:border-asc-orange/30">
          {brand.logo ? (
            <img
              src={brand.logo}
              alt={brand.name}
              class="max-h-16 lg:max-h-20 w-auto object-contain filter grayscale group-hover:grayscale-0 transition-all duration-500"
              loading="lazy"
            />
          ) : (
            <span class="text-gray-700 font-bold text-lg group-hover:text-asc-orange transition-colors duration-300">
              {brand.name}
            </span>
          )}
        </div>
      ))}
    </div>

    <!-- Features Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <div class="bg-white rounded-2xl p-8 shadow-lg border border-gray-100 text-center group hover:shadow-xl transition-all duration-300">
        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">Productos Originales</h3>
        <p class="text-gray-600">Todos nuestros productos son 100% originales, importados directamente de fabrica con certificados de autenticidad.</p>
      </div>

      <div class="bg-white rounded-2xl p-8 shadow-lg border border-gray-100 text-center group hover:shadow-xl transition-all duration-300">
        <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">Garantia de Fabrica</h3>
        <p class="text-gray-600">Respaldamos todos nuestros productos con la garantia oficial del fabricante para tu tranquilidad.</p>
      </div>

      <div class="bg-white rounded-2xl p-8 shadow-lg border border-gray-100 text-center group hover:shadow-xl transition-all duration-300">
        <div class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-8 h-8 text-asc-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">Asesoria Especializada</h3>
        <p class="text-gray-600">Nuestro equipo de expertos te ayudara a elegir el equipo perfecto para tu operacion.</p>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center">
      <p class="text-gray-600 mb-6 text-lg">¿Interesado en precios mayoristas?</p>
      <a
        href="https://wa.me/50624680555?text=Hola,%20estoy%20interesado%20en%20precios%20mayoristas"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center space-x-3 bg-asc-orange hover:bg-orange-600 text-white px-8 py-4 rounded-full font-bold text-lg transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl"
      >
        <span>Solicitar Catalogo Mayorista</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
