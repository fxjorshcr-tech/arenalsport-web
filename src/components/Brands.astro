---
import { brandPartners } from '../config/assets';
---

<section class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="text-asc-orange font-semibold text-sm uppercase tracking-widest">Importador & Distribuidor</span>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mt-2 mb-4">
        Ventas Mayoristas
      </h2>
      <p class="text-gray-600 max-w-2xl mx-auto text-lg">
        Distribuidor autorizado de las siguientes marcas
      </p>
    </div>

    <!-- Brands Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-8">
      {brandPartners.map((brand) => (
        <div class="bg-white rounded-xl p-6 shadow-md hover:shadow-xl transition-all duration-300 flex items-center justify-center h-24 group hover:scale-105">
          <span class="text-gray-700 font-bold text-lg group-hover:text-asc-orange transition-colors duration-300">
            {brand.name}
          </span>
        </div>
      ))}
    </div>

    <!-- Trust Badges -->
    <div class="mt-16 flex flex-wrap justify-center gap-8">
      <div class="flex items-center space-x-3 text-gray-600">
        <svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <span class="font-medium">Productos Originales</span>
      </div>
      <div class="flex items-center space-x-3 text-gray-600">
        <svg class="w-8 h-8 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
        </svg>
        <span class="font-medium">Garantia de Fabrica</span>
      </div>
      <div class="flex items-center space-x-3 text-gray-600">
        <svg class="w-8 h-8 text-asc-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
        </svg>
        <span class="font-medium">Asesoria Especializada</span>
      </div>
    </div>
  </div>
</section>
